{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "948d6cd9cd3d406fbf5b21298770e98a",
    "m_Title": "Multiply 역할",
    "m_Content": "그냥 Time 적용한 y, z값을 그대로 Combine 하면 움직임만 구현됨.\n(동일한 크기로 모든 정점 이동하니까)\n\n따라서, Multiply를 해야지, 각 정점들이 다른 크기로 이동함으로 모양이 찌그러진다.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
