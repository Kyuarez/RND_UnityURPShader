{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9a9ae321dc7e4f3e87ef64290b0d2f36",
    "m_Title": "참고 : 기본 파동 방정식",
    "m_Content": "u(position, t) = A * Sin(waveCount * position - frequency *t)\n\nA : 진폭(Amplitude)\nwaveCount : 파수; 공간적 주기(늘어날 수록 더 촘촘한 파동)\nfrequency : 각속도; 시간적 주기(늘어날 수록 더 빠르게 진동)\nposition : 파동 진원지\nt : 시간(한번 진동하는데 걸리는 시간)\n\n\"파동이 포지션을 따라 t시간 동안 이동하는 것\"을 Sine으로 주기화 한 것.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1516.0,
        "y": 260.0,
        "width": 428.800048828125,
        "height": 176.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

